# ─────────────────────────────────────────────────────────────────────────────
# Agent Rivo — environment template. Copy to .env.local for local dev, and paste
# the same values into Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only the two NEXT_PUBLIC_ vars may reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Project → Settings → API) ---
# Public (safe for the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-only (NEVER expose to the browser). Used by the webhook + seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_your_key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Unipile (WhatsApp) — https://developer.unipile.com/ ---
UNIPILE_DSN=apiXXXX.unipile.com:14XXX
UNIPILE_API_KEY=your-unipile-api-key
# The Unipile account id whose WhatsApp connection you use to send/receive.
UNIPILE_ACCOUNT_ID=your-unipile-account-id
# Shared secret you invent; Unipile is configured to send it so we can trust the webhook.
UNIPILE_WEBHOOK_SECRET=make-up-a-long-random-string

# --- App behaviour ---
APP_BASE_URL=http://localhost:3100
# Fixed demo clock (Europe/Paris). Leave set to reproduce the handbook scenarios.
DEMO_CLOCK=2026-09-07T10:00:00+02:00
# Enables /api/test-runner (second-user access tests, scenario replay). Keep "false" in prod.
ENABLE_LOCAL_TEST_RUNNER=true
# Protects the test runner endpoint when enabled.
TEST_RUNNER_SECRET=another-long-random-string
